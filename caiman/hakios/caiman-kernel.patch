 		if (tm_va[b] == 0) {
diff --git a/tools/mesa/hakios-panthor/hakios.panthor.c b/tools/mesa/hakios-panthor/hakios.panthor.c
new file mode 100644
index 0000000..68143bb
--- /dev/null
+++ b/tools/mesa/hakios-panthor/hakios.panthor.c
@@ -0,0 +1,916 @@
+/*
+ * The libdrm of xf86drm.h for PanVK: Linux's Panthor requests to the kernel's HakiosGPU on the Mali (boot-arg mali=1),
+ * the counterpart of hakios-drm (Adreno, msm). What the kernel has (caiman repo docs/gpu-plan.md, steps 10-14):
+ *
+ *   msm GEM_NEW 0x42, GEM_INFO 0x43, WAIT_FENCE 0x47, GEM_CLOSE 0x09   buffers, their memory, waiting
+ *   0x90 query      the GPU's and the command stream interface's properties
+ *   0x91 submit     one user command stream on one of group 0's three streams; a fence back
+ *   0x92 heap       a tiler heap (context and first chunk)
+ *   0x93 bind       a buffer's pages at a user address (the lower half of the GPU's space), or none there
+ *   0x94 register   an identification register of the GPU's
+ *
+ * Panthor's model maps onto it this way. One VM: the kernel's one user address space (id 1). Groups: every group is
+ * group 0, the kernel's; its three queues are the three streams (PanVK's order: vertex-tiler, fragment, compute). A
+ * submission's waits are waited for here, before it goes to the kernel; its signals get its fence (hakios-drm's
+ * syncobjs). VM binds are done at once, ASYNC or not, their syncs as a submission's. The device is told to be
+ * Panthor 1.2: no MMU_INFO query (4 KiB pages, which is what the kernel maps), no WB mmap (buffers are
+ * write-combined, the GPU not coherent), timestamps and group priorities.
+ */
+#include <errno.h>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+
+#include "xf86drm.h"
+#include "drm-uapi/panthor_drm.h"
+
+#define HAKIOS_GPU_SERVICE      "HakiosGPU"
+#define REQ_GEM_CLOSE           0x09
+#define REQ_GEM_NEW             0x42
+#define REQ_WAIT_FENCE          0x47
+#define REQ_MALI_QUERY          0x90
+#define REQ_MALI_SUBMIT         0x91
+#define REQ_MALI_HEAP           0x92
+#define REQ_MALI_BIND           0x93
+#define REQ_MALI_REGISTER       0x94
+#define MSM_BO_WC               0x00020000
+
+/* the kernel's structures (hakios.gpu.cpp) */
+struct k_gem_new { uint64_t size; uint32_t flags, handle; };
+struct k_gem_close { uint32_t handle, pad; };
+struct k_wait_fence { uint32_t fence, flags; int64_t seconds, nanoseconds; uint32_t queueid; };
+struct k_query {
+	uint32_t gpu_id, l2_features, core_features, tiler_features, mem_features, mmu_features, as_present, csf_id;
+	uint64_t shader_present, tiler_present, l2_present;
+	uint32_t csg_slots, cs_slots, cs_regs, scoreboards, unpreserved_regs, timestamp_hz;
+};
+struct k_submit { uint32_t queue, size; uint64_t address; uint32_t fence, pad; };
+struct k_heap { uint32_t chunk_size, chunks; uint64_t context, first_chunk; };
+struct k_bind { uint32_t handle, flags; uint64_t va, offset, size; };
+struct k_register { uint32_t offset, value; };
+
+static io_connect_t connection;
+static int connection_fd = -1;
+static pthread_mutex_t open_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static bool
+connect_once(void)
+{
+	io_service_t service;
+	bool ok;
+
+	pthread_mutex_lock(&open_lock);
+	if (connection != 0) {
+		pthread_mutex_unlock(&open_lock);
+		return true;
+	}
+	service = IOServiceGetMatchingService(0, IOServiceMatching(HAKIOS_GPU_SERVICE));
+	ok = service != 0 && IOServiceOpen(service, mach_task_self(), 0, &connection) == 0;
+	if (service != 0) {
+		IOObjectRelease(service);
+	}
+	pthread_mutex_unlock(&open_lock);
+	return ok;
+}
+
+static int
+call(unsigned number, void *data, size_t size)
+{
+	size_t returned = size;
+	kern_return_t result;
+
+	if (!connect_once()) {
+		return ENODEV;
+	}
+	result = IOConnectCallStructMethod(connection, number, data, size, data, &returned);
+	switch (result) {
+	case 0:
+		return 0;
+	case kIOReturnNoMemory:
+		return ENOMEM;
+	case kIOReturnBadArgument:
+		return EINVAL;
+	case kIOReturnTimeout:
+		return ETIMEDOUT;
+	case kIOReturnBusy:
+		return EBUSY;
+	case kIOReturnNotFound:
+		return ENOENT;
+	case kIOReturnUnsupported:
+		return ENOSYS;
+	default:
+		return EIO;
+	}
+}
+
+/* HAKIOS_PANTHOR_TRACE=1: the first few of every request and what came of it, on standard error */
+static bool
+tracing(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		const char *v = getenv("HAKIOS_PANTHOR_TRACE");
+		on = v != NULL && *v != '0';
+	}
+	return on;
+}
+
+static void
+trace(const char *what, unsigned id, int error)
+{
+	static unsigned seen[64];
+
+	if (tracing() && seen[id & 63]++ < 8) {
+		fprintf(stderr, "hakios-panthor: %s %u: %s\n", what, id, error ? strerror(error) : "ok");
+	}
+}
+
+static int
+fail(int error)
+{
+	errno = error;
+	return -1;
+}
+
+static void
+say_once(const char *what)
+{
+	static char said[16][48];
+	static unsigned count;
+
+	for (unsigned i = 0; i < count; i++) {
+		if (strcmp(said[i], what) == 0) {
+			return;
+		}
+	}
+	if (count < 16) {
+		strlcpy(said[count++], what, sizeof(said[0]));
+	}
+	fprintf(stderr, "hakios-panthor: %s: not here\n", what);
+}

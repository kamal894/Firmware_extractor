+/* A frame is about to be drawn: into the buffer the display is not reading, once it has stopped reading it. */
+void
+IOMobileFramebuffer::flipBegin(void)
+{
+	uint64_t deadline;
+
+	if (fFlipBuffer[1] == NULL) {
+		return;
+	}
+	/* the display's shadow copy of the address (+0x400: what it reads now) says when it has switched */
+	if (fFlipAddress[0x100] != (uint32_t) fFlipPhysical[fFlipShown]) {
+		fFlipWaits++;
+		clock_interval_to_deadline(50, NSEC_PER_MSEC, &deadline);
+		while (fFlipAddress[0x100] != (uint32_t) fFlipPhysical[fFlipShown]) {
+			if (mach_absolute_time() > deadline) {
+				fFlipLate++;
+				break;
+			}
+			delay(200);
+		}
+	}
+	fBase = fFlipBuffer[fFlipShown ^ 1];

diff --git a/userland/src/mali_test.c b/userland/src/mali_test.c
new file mode 100644
index 0000000..ea4d4a1
--- /dev/null
+++ b/userland/src/mali_test.c
@@ -0,0 +1,176 @@
+/*
+ * The Pixel 9 Pro's Mali from user space, through HakiosGPU (drivers/gpu/hakios.gpu.cpp) with boot-arg mali=1:
+ * what a Panthor stand-in for PanVK will do (caiman repo docs/panvk-uapi.md), in the smallest steps. The GPU's
+ * properties (request 0x90); a buffer (msm GEM_NEW 0x42), its GPU address (GEM_INFO 0x43, IOVA) and a mapping of
+ * it here (the client memory of the buffer's handle); a command stream written into it that stores a word, run
+ * on each of group 0's three streams (0x91) and waited for (msm WAIT_FENCE 0x47); a tiler heap as PanVK asks for
+ * one (0x92). Prints one line per step. Run by rc.jobs.malitest.
+ */
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+/* IOKit, declared here: the iPhoneOS SDK ships the framework without its headers */
+typedef mach_port_t io_object_t;
+typedef io_object_t io_service_t;
+typedef io_object_t io_connect_t;
+extern const mach_port_t kIOMainPortDefault;
+extern void *IOServiceMatching(const char *name);
+extern io_service_t IOServiceGetMatchingService(mach_port_t main, void *matching);
+extern kern_return_t IOServiceOpen(io_service_t service, task_port_t task, uint32_t type, io_connect_t *connect);
+extern kern_return_t IOConnectCallStructMethod(mach_port_t connection, uint32_t selector, const void *in, size_t in_size,
+    void *out, size_t *out_size);
+extern kern_return_t IOConnectMapMemory64(io_connect_t connect, uint32_t type, task_port_t task, mach_vm_address_t *address,
+    mach_vm_size_t *size, uint32_t options);
+
+struct mali_query {
+	uint32_t gpu_id, l2_features, core_features, tiler_features, mem_features, mmu_features, as_present, csf_id;
+	uint64_t shader_present, tiler_present, l2_present;
+	uint32_t csg_slots, cs_slots, cs_regs, scoreboards, unpreserved_regs, timestamp_hz;
+};
+struct mali_submit {
+	uint32_t queue, size;
+	uint64_t address;
+	uint32_t fence, pad;
+};
+struct mali_tiler_heap {
+	uint32_t chunk_size, chunks;
+	uint64_t context, first_chunk;
+};
+struct msm_gem_new {
+	uint64_t size;
+	uint32_t flags, handle;
+};
+struct msm_gem_info {
+	uint32_t handle, info;
+	uint64_t value;
+	uint32_t len, pad;
+};
+struct msm_wait_fence {
+	uint32_t fence, flags;
+	int64_t seconds, nanoseconds;
+	uint32_t queueid;
+};
+
+static io_connect_t gpu;
+
+static kern_return_t
+call(uint32_t selector, void *r, size_t size)
+{
+	size_t out = size;
+
+	return IOConnectCallStructMethod(gpu, selector, r, size, r, &out);
+}
+
+int
+main(void)
+{
+	io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("HakiosGPU"));
+	struct mali_query q = { 0 };
+	struct msm_gem_new bo = { .size = 0x10000, .flags = 0x00020000 /* MSM_BO_WC */ };
+	struct msm_gem_info info = { 0 };
+	mach_vm_address_t cpu = 0;
+	mach_vm_size_t mapped = 0;
+	kern_return_t kr;
+
+	if (service == 0 || IOServiceOpen(service, mach_task_self(), 0, &gpu) != KERN_SUCCESS) {
+		printf("mali_test: no HakiosGPU service (boot-arg mali=1?)\n");
+		return 1;
+	}
+	kr = call(0x90, &q, sizeof(q));
+	printf("mali_test: query %#x: GPU_ID %#x, shader cores %#llx, tiler %#llx, L2 %#llx; CSF %#x; %u CSG slots, %u streams, "
+	    "%u registers (%u the kernel's), %u scoreboards, timestamp %u Hz\n", kr, q.gpu_id, q.shader_present, q.tiler_present,
+	    q.l2_present, q.csf_id, q.csg_slots, q.cs_slots, q.cs_regs, q.unpreserved_regs, q.scoreboards, q.timestamp_hz);
+
+	kr = call(0x42, &bo, sizeof(bo));
+	info.handle = bo.handle;
+	info.info = 1;                                  /* MSM_INFO_GET_IOVA */
+	if (kr == KERN_SUCCESS) {
+		kr = call(0x43, &info, sizeof(info));
+	}
+	if (kr == KERN_SUCCESS) {
+		kr = IOConnectMapMemory64(gpu, bo.handle, mach_task_self(), &cpu, &mapped, 1 /* kIOMapAnywhere */);
+	}
+	printf("mali_test: buffer %u: %#x, GPU address %#llx, mapped here at %#llx (%llu bytes)\n", bo.handle, kr, info.value,
+	    (unsigned long long)cpu, (unsigned long long)mapped);
+	if (kr != KERN_SUCCESS) {
+		return 1;
+	}
+
+	for (uint32_t st = 0; st < 3; st++) {
+		volatile uint64_t *cs = (volatile uint64_t *)(uintptr_t)cpu;
+		volatile uint32_t *word = (volatile uint32_t *)(uintptr_t)(cpu + 0x800);
+		struct mali_submit s = { .queue = st, .size = 5 * 8, .address = info.value };
+		struct msm_wait_fence w = { 0 };
+
+		*word = 0;
+		cs[0] = (0x01ULL << 56) | (0ULL << 48) | (info.value + 0x800);         /* MOVE48 r0:r1 = the word */
+		cs[1] = (0x02ULL << 56) | (2ULL << 48) | (0x05e70000 + st);            /* MOVE32 r2 */
+		cs[2] = (0x1cULL << 56) | (1ULL << 32);                                 /* SB_SEL_OTHER 0 */
+		cs[3] = (0x15ULL << 56) | (2ULL << 48) | (0ULL << 40) | (1ULL << 16);   /* STORE_MULTIPLE r2 -> [r0] */
+		cs[4] = (0x03ULL << 56) | (1ULL << 16);                                 /* WAIT slot 0 */

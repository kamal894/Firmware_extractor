diff --git a/drivers/input/hakios.buttons.c b/drivers/input/hakios.buttons.c
index 27203ee..51e621a 100644
--- a/drivers/input/hakios.buttons.c
+++ b/drivers/input/hakios.buttons.c
@@ -1,7 +1,7 @@
 /*
  * The buttons of the POCO X5 Pro (redwood) -- power, volume up, volume down -- as a source of
  * button records for /dev/hakios-touch (sys/hakios.input.h). Only with boot-arg buttons=1:
- * every address below belongs to this phone.
+ * every address below belongs to this phone. buttons=2 is the Pixel 9 Pro's (near the end of the file).
  *
  * None of the three is a pin of the SoC. They are inputs of two of the power management chips:
  *   power        KPDPWR_N of the power-on block ("PON") of the PMK8350
@@ -514,6 +514,73 @@ out:
 	thread_terminate(current_thread());
 }
 
+/*
+ * boot-arg buttons=2: the Pixel 9 Pro (caiman, Tensor G4). There the three keys are plain pins of the
+ * SoC's always-on GPIO block (GPIO_ALIVE, 0x154d0000), low while held:
+ *   power        gpa4-0
+ *   volume down  gpa4-1
+ *   volume up    gpa6-2
+ * Read only, like the rest of this file: the boot loader has left each pin an input (function 0)
+ * or an external interrupt (0xf); a pin set up as anything else is left alone and not believed.
+ */
+#define CAIMAN_ALIVE_PHYS       0x154d0000UL
+#define CAIMAN_ALIVE_SIZE       0x1000UL
+#define CAIMAN_GPA4             0x80            /* a bank: CON (4 bits a pin) at +0, DAT at +4 */
+#define CAIMAN_GPA6             0xa0
+
+static vm_offset_t caiman_alive;
+
+static bool
+caiman_pin_usable(uint32_t bank, unsigned pin, const char *name)
+{
+	uint32_t function = rd(caiman_alive + bank) >> (4 * pin) & 0xf;
+
+	if (function == 0x0 || function == 0xf) {
+		return true;
+	}
+	printf("buttons: %s (pin %u of the bank at +%#x) is set up as function %#x, not an input: left alone\n", name, pin,
+	    bank, function);
+	return false;
+}
+
+static void
+caiman_poll(void)
+{
+	uint32_t a4 = rd(caiman_alive + CAIMAN_GPA4 + 4), a6 = rd(caiman_alive + CAIMAN_GPA6 + 4);
+
+	button_look(&power, !(a4 & 1));
+	button_look(&volume_down, !(a4 & 2));
+	button_look(&volume_up, !(a6 & 4));
+	bus.reads++;
+}
+
+static void
+caiman_buttons_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	printf("buttons: caiman: map GPIO_ALIVE at %#lx\n", CAIMAN_ALIVE_PHYS);
+	caiman_alive = ml_io_map(CAIMAN_ALIVE_PHYS, CAIMAN_ALIVE_SIZE);
+	printf("buttons: caiman: gpa4 CON %#x DAT %#x, gpa6 CON %#x DAT %#x\n", rd(caiman_alive + CAIMAN_GPA4),
+	    rd(caiman_alive + CAIMAN_GPA4 + 4), rd(caiman_alive + CAIMAN_GPA6), rd(caiman_alive + CAIMAN_GPA6 + 4));
+	power.usable = caiman_pin_usable(CAIMAN_GPA4, 0, power.name);
+	volume_down.usable = caiman_pin_usable(CAIMAN_GPA4, 1, volume_down.name);
+	volume_up.usable = caiman_pin_usable(CAIMAN_GPA6, 2, volume_up.name);
+	power.last = !(rd(caiman_alive + CAIMAN_GPA4 + 4) & 1);
+	volume_down.last = !(rd(caiman_alive + CAIMAN_GPA4 + 4) & 2);
+	volume_up.last = !(rd(caiman_alive + CAIMAN_GPA6 + 4) & 4);
+	power.live = power.usable && !power.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	printf("buttons: caiman: watching%s%s%s, every %u ms: power is the side button\n", power.usable ? " power" : "",
+	    volume_up.usable ? " volume-up" : "", volume_down.usable ? " volume-down" : "", POLL_MS);
+	for (unsigned tick = 1;; tick++) {
+		caiman_poll();
+		if (tick % MINUTE_TICKS == 0 || tick == 10 * 1000 / POLL_MS) {
+			say_summary();
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+}
+
 /*
  * boot-arg press_power=<seconds>: a short press of the power key that many seconds after boot, and another ten
  * seconds later, given to Darwin as the key's own are (hakios_touch_post): the lock, and the wake, tried with nobody
@@ -585,7 +652,8 @@ hakios_buttons_init(void)
 	if (steps == 0) {
 		return;
 	}
-	if (kernel_thread_start(buttons_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+	if (kernel_thread_start(enabled == 2 ? caiman_buttons_thread : buttons_thread, (void *)(uintptr_t)steps,
+	    &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
diff --git a/drivers/input/hakios.goodix.c b/drivers/input/hakios.goodix.c
index 38c9ff2..13e5398 100644
--- a/drivers/input/hakios.goodix.c
+++ b/drivers/input/hakios.goodix.c
@@ -1548,6 +1548,197 @@ goodix_thread(__unused void *parameter, __unused wait_result_t result)
 	}
 }
 
+/*
+ * boot-arg touchscreen=2: the Pixel 9 Pro (caiman, Tensor G4): a Synaptics S3908 speaking TouchComm v1
+ * on HSI0's USI2 as SPI (0x111d0000). The loader (caiman probe, PROBE_TOUCH=9) has done the parts that
+ * need the PMIC and the clocks: LDO4M then LDO25M on, the SPI set up, CMU_HSI0's USI2 divider at 3
+ * (about 3 MHz; at 0 the clock is over the chip's 10 MHz and nothing answers), the chip reset and its
+ * startup identify read. Here only the SPI and the interrupt pin (gpn0-0, low while the chip has a
+ * message) are used; nothing is written but the SPI's own registers.
+ *
+ * A message is "A5 code len_lo len_hi" in one transaction, then "A5 03" + payload + "5A" in the next.
+ * Report 0x11, in the layout the chip's report config (command 0x25) gives: 11 bytes of header (the
+ * number of fingers at [10]), then 12 bytes a finger: index | class << 4, X, Y, Z (16 bits each,
+ * little-endian), widths and three vendor bytes. X and Y are in tenths of a pixel of the 1280 x 2856
+ * panel. Checked on the phone with the loader's own copy of this reading (caiman docs/touch-plan.md).
+ */
+#define SYNA_SPI_PHYS           0x111d0000UL
+#define SYNA_IRQ_PHYS           0x15060000UL    /* gpn0: CON +0, DAT +4; the interrupt is pin 0 */
+#define SYNA_MAX_X              12800
+#define SYNA_MAX_Y              28560
+#define SYNA_FINGERS            10
+
+#define SPI_CH_CFG              0x00
+#define SPI_SLAVE_SEL           0x0c
+#define SPI_STATUS              0x14
+#define SPI_TX_DATA             0x18
+#define SPI_RX_DATA             0x1c
+#define SPI_PACKET_CNT          0x20
+#define SPI_CH_SW_RST           (1u << 5)
+#define SPI_CH_ON               3u              /* RX and TX channels */
+#define SPI_PACKET_CNT_EN       (1u << 16)
+#define SPI_RX_LVL(st)          (((st) >> 15) & 0x7f)
+#define SPI_TX_LVL(st)          (((st) >> 6) & 0x7f)
+
+static vm_offset_t syna_spi, syna_irq;
+static struct {
+	bool down;
+	uint32_t x, y;
+} syna_contact[SYNA_FINGERS];
+static struct {
+	uint32_t messages, reports, bad, shown;
+} syna_seen;
+
+static bool
+syna_pending(void)
+{
+	return !(rd(syna_irq + 4) & 1);
+}
+
+/* One transaction under chip select: n bytes of 00 out, n in. Returns how many came back. */
+static uint32_t
+syna_read(uint8_t *rx, uint32_t n)
+{
+	uint32_t sent = 0, got = 0;
+	uint64_t start = mach_absolute_time(), limit;
+
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &limit);
+	wr(syna_spi + SPI_CH_CFG, rd(syna_spi + SPI_CH_CFG) | SPI_CH_SW_RST);
+	delay(1);
+	wr(syna_spi + SPI_CH_CFG, rd(syna_spi + SPI_CH_CFG) & ~(SPI_CH_SW_RST | SPI_CH_ON));
+	wr(syna_spi + SPI_PACKET_CNT, n & 0xffff);
+	wr(syna_spi + SPI_PACKET_CNT, (n & 0xffff) | SPI_PACKET_CNT_EN);
+	wr(syna_spi + SPI_SLAVE_SEL, 0);
+	delay(10);
+	for (; sent < n && sent < 32; sent++) {
+		wr(syna_spi + SPI_TX_DATA, 0);
+	}
+	wr(syna_spi + SPI_CH_CFG, rd(syna_spi + SPI_CH_CFG) | SPI_CH_ON);
+	while (got < n && mach_absolute_time() - start < limit) {
+		uint32_t level = SPI_RX_LVL(rd(syna_spi + SPI_STATUS));
+
+		while (level-- && got < n) {
+			rx[got++] = (uint8_t)rd(syna_spi + SPI_RX_DATA);
+		}
+		while (sent < n && SPI_TX_LVL(rd(syna_spi + SPI_STATUS)) < 32) {
+			wr(syna_spi + SPI_TX_DATA, 0);
+			sent++;
+		}
+	}
+	wr(syna_spi + SPI_CH_CFG, rd(syna_spi + SPI_CH_CFG) & ~SPI_CH_ON);
+	wr(syna_spi + SPI_SLAVE_SEL, 1);
+	return got;
+}
+
+/* One message: its code, and the payload (up to max bytes). Returns the payload's length, -1 for none. */
+static int
+syna_message(uint8_t *code, uint8_t *payload, uint32_t max)
+{
+	uint8_t h[4] = { 0 }, m[256];
+	uint32_t len;
+
+	if (syna_read(h, 4) != 4 || h[0] != 0xa5) {
+		return -1;
+	}
+	*code = h[1];
+	len = h[2] | (uint32_t)h[3] << 8;
+	if (len == 0) {
+		return 0;
+	}
+	if (len > sizeof(m) - 3) {
+		len = sizeof(m) - 3;
+	}
+	delay(100);
+	if (syna_read(m, len + 3) != len + 3 || m[1] != 0x03) {
+		return -1;
+	}
+	memcpy(payload, m + 2, len < max ? len : max);
+	return (int)(len < max ? len : max);
+}
+
+static void
+syna_report(const uint8_t *r, int n)
+{
+	bool seen[SYNA_FINGERS] = { false };
+
+	for (int p = 11; p + 12 <= n; p += 12) {
+		uint32_t id = r[p] & 0xf, kind = r[p] >> 4;
+		uint32_t x = r[p + 1] | (uint32_t)r[p + 2] << 8, y = r[p + 3] | (uint32_t)r[p + 4] << 8;
+
+		if (id >= SYNA_FINGERS || kind == 0) {
+			continue;
+		}
+		if (syna_seen.shown < 40) {
+			syna_seen.shown++;
+			printf("syna: finger %u at %u, %u (of %u x %u)\n", id, x, y, SYNA_MAX_X, SYNA_MAX_Y);
+		}
+		x = x >= SYNA_MAX_X ? 65535 : x * 65535 / SYNA_MAX_X;
+		y = y >= SYNA_MAX_Y ? 65535 : y * 65535 / SYNA_MAX_Y;
+		if (flip & 1) {
+			x = 65535 - x;
+		}
+		if (flip & 2) {
+			y = 65535 - y;
+		}
+		seen[id] = true;
+		hakios_touch_post(syna_contact[id].down ? HAKIOS_TOUCH_MOVE : HAKIOS_TOUCH_DOWN, id, x, y);
+		syna_contact[id].down = true;
+		syna_contact[id].x = x;
+		syna_contact[id].y = y;
+	}
+	for (uint32_t id = 0; id < SYNA_FINGERS; id++) {
+		if (syna_contact[id].down && !seen[id]) {
+			hakios_touch_post(HAKIOS_TOUCH_UP, id, syna_contact[id].x, syna_contact[id].y);
+			syna_contact[id].down = false;
+		}
+	}
+}
+
+static void
+syna_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint8_t payload[256], code = 0;
+	uint64_t next_summary = 0, minute;
+
+	printf("syna: caiman: map SPI at %#lx, interrupt pin at %#lx\n", SYNA_SPI_PHYS, SYNA_IRQ_PHYS);
+	syna_spi = ml_io_map(SYNA_SPI_PHYS, 0x1000);
+	syna_irq = ml_io_map(SYNA_IRQ_PHYS, 0x1000);
+	printf("syna: caiman: SPI MODE_CFG %#x CH_CFG %#x STATUS %#x; gpn0 CON %#x DAT %#x\n", rd(syna_spi + 0x08),
+	    rd(syna_spi + SPI_CH_CFG), rd(syna_spi + SPI_STATUS), rd(syna_irq), rd(syna_irq + 4));
+	if (rd(syna_spi + 0x08) != 0x3ffu << 19) {
+		printf("syna: the SPI is not as the loader leaves it (PROBE_TOUCH=9): no touch screen\n");
+		return;
+	}
+	printf("syna: watching the interrupt pin every 4 ms; touch_flip=%u\n", flip);
+	nanoseconds_to_absolutetime(60 * NSEC_PER_SEC, &minute);
+	for (;;) {
+		/* while the pin is low there is a message; a finger on the screen makes one every ~1.5 ms */
+		for (int i = 0; i < 16 && syna_pending(); i++) {
+			int n = syna_message(&code, payload, sizeof(payload));
+
+			if (n < 0) {
+				syna_seen.bad++;
+				break;
+			}
+			syna_seen.messages++;
+			if (code == 0x11 && n >= 11) {
+				syna_seen.reports++;
+				syna_report(payload, n);
+			} else if (syna_seen.messages < 20) {
+				printf("syna: message %#x, %d bytes\n", code, n);
+			}
+		}
+		if (mach_absolute_time() > next_summary) {
+			if (next_summary) {
+				printf("syna: so far %u messages, %u touch reports, %u unreadable\n", syna_seen.messages,
+				    syna_seen.reports, syna_seen.bad);
+			}
+			next_summary = mach_absolute_time() + minute;
+		}
+		sleep_ms(4);
+	}
+}
+
 void
 hakios_goodix_init(void)
 {
@@ -1558,7 +1749,7 @@ hakios_goodix_init(void)
 		return;
 	}
 	PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
-	if (kernel_thread_start(goodix_thread, NULL, &thread) == KERN_SUCCESS) {
+	if (kernel_thread_start(enabled == 2 ? syna_thread : goodix_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
diff --git a/drivers/power/hakios.thermal.c b/drivers/power/hakios.thermal.c
index 8d69400..f6ebbf9 100644
--- a/drivers/power/hakios.thermal.c
+++ b/drivers/power/hakios.thermal.c
@@ -41,6 +41,7 @@
  *
  * Boot-args:
  *   thermal=1          read the sensors
+ *   thermal=2          the Pixel 9 Pro: read its zones through ACPM and slow the CPUs when hot (near the end)
  *   thermal_poll=<ms>  how often (200 to 60000; 2000)
  *   thermal_log=<s>    a summary line this often (0: only on a rise; 60)
  *   thermal_stop=<C>   stop the run at this temperature (0: never; 105)
@@ -245,6 +246,217 @@ tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
 	thread_call_enter_delayed(call, deadline);
 }
 
+/*
+ * thermal=2: the Pixel 9 Pro (caiman, Tensor G4 "zuma"). There the temperatures and the CPU clocks are both
+ * ACPM's (the power-management core), asked through its IPC: a request of four words in a queue in its SRAM
+ * (0x15700000) and a doorbell in its mailbox (0x15110000), the reply in another queue (Google's acpm_ipc.c; the
+ * caiman loader's probe/dvfs.c does the same before the kernel and raises the clocks: CPU clusters 1696, 2130 and
+ * 2499 MHz, memory 2028). Nothing in iOS here slows the CPUs when the phone gets hot; this does:
+ *   - every thermal_poll ms (default 1000) the BIG, MID and LITTLE zones are read (TMU_IPC_READ_TEMP on ACPM's
+ *     TMU channel 9: exynos_acpm_tmu.c), degrees Celsius;
+ *   - by the hottest, a level of clocks for the three clusters (FREQ_REQ on the DVFS channel 1: acpm_dvfs.c),
+ *     each a step of Android's own table; down at once, back up only 5 degrees below the edge it crossed;
+ *   - the stop at thermal_stop degrees three times in a row (default 95 here) as on the other phone.
+ * Measured on the phone before this was written: 45-46 C at the loader, 66-67 C for BIG and MID under Android.
+ */
+#define ZUMA_ACPM_MBOX          0x15110000UL
+#define ZUMA_ACPM_SRAM          0x15700000UL
+#define ZUMA_ACPM_SRAM_SIZE     0x58000u
+#define ZUMA_ACPM_INITDATA      0xa000u
+#define ZUMA_APM_INTGR          0x40
+#define ZUMA_AP_INTCR           0x24
+#define ZUMA_DVFS_CHANNEL       1
+#define ZUMA_TMU_CHANNEL        9
+
+static vm_offset_t zuma_sram, zuma_mbox;
+static uint32_t zuma_seq, zuma_level, zuma_errors;
+
+static const struct {
+	uint32_t below;                 /* the level holds while the hottest zone is below this */
+	uint32_t khz[3];                /* CPUCL0 (A520), CPUCL1 (A720), CPUCL2 (X4) */
+} zuma_levels[] = {
+	{ 70, { 1696000, 2130000, 2499000 } },  /* what the loader set */
+	{ 80, { 1548000, 1795000, 2147000 } },
+	{ 90, { 1328000, 1328000, 1557000 } },
+	{ 999, { 1098000, 1065000, 1164000 } }, /* about the boot loader's own */
+};
+
+static uint32_t
+zuma_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(zuma_sram + off);
+}
+
+static void
+zuma_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(zuma_sram + off) = value;
+}
+
+/* One request on ACPM channel ch, its reply in cmd; every reply in the queue is taken off. 0, or -1. */
+static int
+zuma_acpm(uint32_t ch, uint32_t *cmd)
+{
+	uint32_t base = zuma_rd(ZUMA_ACPM_INITDATA + 8) + ch * 72;
+	uint32_t id, len, esz, txf_at, txr_at, rxf_at, rxr_at, txb, rxb, txf, txr, seq;
+	uint64_t deadline;
+
+	if (base >= ZUMA_ACPM_SRAM_SIZE) {
+		return -1;
+	}
+	id = zuma_rd(base);
+	txr_at = zuma_rd(base + 16);
+	txf_at = zuma_rd(base + 20);
+	txb = zuma_rd(base + 24);
+	rxr_at = zuma_rd(base + 40);
+	rxf_at = zuma_rd(base + 44);
+	rxb = zuma_rd(base + 48);
+	len = zuma_rd(base + 52);
+	esz = zuma_rd(base + 56);
+	if (len == 0 || len > 64 || esz < 16 || esz > 64 || txb + len * esz > ZUMA_ACPM_SRAM_SIZE ||
+	    rxb + len * esz > ZUMA_ACPM_SRAM_SIZE || txf_at >= ZUMA_ACPM_SRAM_SIZE || txr_at >= ZUMA_ACPM_SRAM_SIZE ||
+	    rxf_at >= ZUMA_ACPM_SRAM_SIZE || rxr_at >= ZUMA_ACPM_SRAM_SIZE) {
+		return -1;
+	}
+	txf = zuma_rd(txf_at);
+	txr = zuma_rd(txr_at);
+	if (txf >= len || txr >= len || (txf + 1) % len == txr) {
+		return -1;
+	}
+	if (++zuma_seq >= 64) {
+		zuma_seq = 1;
+	}
+	seq = zuma_seq;
+	cmd[0] |= seq << 16;
+	for (uint32_t i = 0; i < esz; i += 4) {
+		zuma_wr(txb + esz * txf + i, i < 16 ? cmd[i / 4] : 0);
+	}
+	__builtin_arm_dsb(0xf);
+	zuma_wr(txf_at, (txf + 1) % len);
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)(zuma_mbox + ZUMA_APM_INTGR) = 1u << id;
+	clock_interval_to_deadline(50, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint32_t rf = zuma_rd(rxf_at), rr = zuma_rd(rxr_at);
+
+		if (rf >= len || rr >= len) {
+			break;
+		}
+		for (; rr != rf; rr = (rr + 1) % len) {
+			uint32_t at = rxb + esz * rr;
+			bool mine = ((zuma_rd(at) >> 16) & 0x3f) == seq;
+
+			if (mine) {
+				for (uint32_t i = 0; i < 4; i++) {
+					cmd[i] = zuma_rd(at + 4 * i);
+				}
+			}
+			zuma_wr(rxr_at, (rr + 1) % len);
+			*(volatile uint32_t *)(zuma_mbox + ZUMA_AP_INTCR) = 1u << id;
+			if (mine) {
+				return 0;
+			}
+		}
+		delay(20);
+	}
+	return -1;
+}
+
+static void
+zuma_set_level(uint32_t level, int hottest)
+{
+	for (uint32_t c = 0; c < 3; c++) {
+		uint32_t cmd[4] = { 2 + c, zuma_levels[level].khz[c], 0 /* FREQ_REQ */, 0 };
+
+		if (zuma_acpm(ZUMA_DVFS_CHANNEL, cmd) != 0) {
+			zuma_errors++;
+		}
+	}
+	say("thermal: %d C: CPU clocks %u, %u, %u MHz (level %u, was %u)\n", hottest, zuma_levels[level].khz[0] / 1000,
+	    zuma_levels[level].khz[1] / 1000, zuma_levels[level].khz[2] / 1000, level, zuma_level);
+	zuma_level = level;
+}
+
+static void
+zuma_look(void)
+{
+	static const char zone[3][8] = { "BIG", "MID", "LITTLE" };
+	int temp[3], hottest = -1, hot = 0;
+	uint32_t want = 0;
+	uint64_t now = mach_absolute_time(), nanos;
+
+	for (uint32_t z = 0; z < 3; z++) {
+		uint32_t cmd[4] = { 0, 2 /* TMU_IPC_READ_TEMP */ | z << 16, 0, 0 };
+
+		temp[z] = zuma_acpm(ZUMA_TMU_CHANNEL, cmd) == 0 ? (int)(cmd[1] >> 24) : -1;
+		if (temp[z] < 0) {
+			zuma_errors++;
+		}
+		if (temp[z] > hottest) {
+			hottest = temp[z];
+			hot = (int)z;
+		}
+	}
+	reads++;
+	thermal_reads_value = (int)reads;
+	if (hottest < 0) {
+		return;
+	}
+	thermal_max_mc = hottest * 1000;
+	strlcpy(thermal_hottest, zone[hot], sizeof(thermal_hottest));

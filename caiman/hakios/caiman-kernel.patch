-	uint8_t *       fBase;                  /* the boot framebuffer: the panel */
+	uint8_t *       fBase;                  /* the boot framebuffer: the panel (with fb_flip: the one being drawn) */
+	uint8_t *       fFlipBuffer[2];         /* fb_flip: the two buffers, mapped */
+	uint64_t        fFlipPhysical[2];
+	volatile uint32_t * fFlipAddress;      /* the display's register of the address it reads */
+	volatile uint32_t * fFlipUpdate;       /* ... and the controller's shadow update request; its frame counter */
+	volatile uint32_t * fFlipFrames;

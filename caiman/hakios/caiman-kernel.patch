 	bool by_itself = false;
 
+	if (PE_parse_boot_argn("mali", &only, sizeof(only)) && only) {
+		mali_handoff();
+		return;
+	}
+
 	if (PE_parse_boot_argn("display_probe", &only, sizeof(only)) && only) {
 		display_probe();
 	}

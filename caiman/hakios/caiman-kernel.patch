 static TUNABLE(uint64_t, gIntfPhysical, "fb_intf", 0);
+/*
+ * Boot-arg fb_flip=1: two buffers, for a display controller that the loader says how to point at either
+ * (/chosen fb-flip: the two buffers' physical addresses, the register that holds the address the display
+ * reads, and the controller's register that asks for its shadow registers to be taken over at the next
+ * frame; the caiman loader, probe/xnu.c). Each frame is drawn into the buffer the panel is not reading and
+ * then the controller is pointed at it: on the Pixel 9 Pro the controller (command mode, a frame every
+ * TE) reads the one buffer while it is written, and the screen flickered where things moved (17 November).
+ * A frame is not begun in a buffer until the display's shadow register says it has gone over to the other.
+ * What a frame's layers do not cover is two frames old in that buffer: iOS's bottom layer covers the screen.
+ */
+static TUNABLE(uint32_t, gFlip, "fb_flip", 0);
 
 static vm_offset_t

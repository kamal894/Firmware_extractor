+/* ---- Panthor's requests ---------------------------------------------------------------------------------------------- */
+
+static uint32_t
+reg(uint32_t offset)
+{
+	struct k_register r = { offset, 0 };
+
+	return call(REQ_MALI_REGISTER, &r, sizeof(r)) == 0 ? r.value : 0;

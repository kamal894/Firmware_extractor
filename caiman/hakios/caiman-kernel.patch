index 0000000..bb153ac
--- /dev/null
+++ b/tools/mk-panvk.sh
@@ -0,0 +1,88 @@
+#!/bin/bash
+# Build PanVK, Mesa's Vulkan driver for the Mali (CSF: v10 and up; the Pixel 9 Pro's G715 is v11), for the Darwin
+# userland: the Mali's counterpart of tools/mk-turnip.sh, for metal2vulkan on the Pixel (caiman repo
+# docs/metal-mali-plan.md). PanVK's Panthor interface talks to the kernel's HakiosGPU (mali=1) through
+# tools/mesa/hakios-panthor, the stand-in for libdrm.
+#
+# Mesa main is needed (25.0.7, mk-mesa.sh's, has no v11 PanVK), so this tree is its own: ~/caiman-work/panvk-build
+# or $PANVK_BUILD, with tools/mesa/panvk-darwin.patch on. Two builds:
+#   native  for this Mac: mesa_clc, vtn_bindgen2 and panfrost_compile, which compile PanVK's OpenCL C helpers
+#           (Homebrew: meson ninja pkg-config glslang spirv-tools spirv-llvm-translator libclc llvm);
+#   ios     PanVK itself, with xnu-clang and the iPhoneOS SDK, those three tools taken from native.
+# The native build needs libdrm's headers only to compile: hoststub/ gives them (never run on the Mac).
+#
+# What comes out: $PANVK_BUILD/out/libvulkan_panfrost.dylib (install name /redwood/lib/libvulkan_panfrost.dylib).
+set -e
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+COMMIT=${MESA_COMMIT:-da2d473}
+B=${PANVK_BUILD:-$HOME/caiman-work/panvk-build}
+SDK=$ROOT/xnu-deps/theos-mac/sdks/iPhoneOS16.5.sdk
+export PATH=$B/hostbin:$B/venv/bin:/opt/homebrew/opt/llvm/bin:/opt/homebrew/bin:$ROOT/xnu-deps/host/bin:$PATH
+export PKG_CONFIG_PATH=/opt/homebrew/lib/pkgconfig:/opt/homebrew/opt/llvm/lib/pkgconfig
+mkdir -p "$B/out" "$B/hostbin" "$B/hoststub/sys"
+cd "$B"
+
+if [ ! -d mesa ]; then
+	git clone -q https://gitlab.freedesktop.org/mesa/mesa.git mesa
+	git -C mesa checkout -q "$COMMIT"
+fi
+if ! git -C mesa diff --quiet; then
+	:       # already patched (by this script, or by hand while working on it)
+else
+	git -C mesa apply "$ROOT/tools/mesa/panvk-darwin.patch"
+fi
+if [ ! -x venv/bin/python3 ]; then
+	python3 -m venv venv
+	venv/bin/pip -q install mako pyyaml packaging pycparser
+fi
+
+# libdrm's headers for the native build (see above)
+cat > hoststub/xf86drm.h <<H
+#include "$ROOT/tools/mesa/hakios-panthor/xf86drm.h"
+H
+
+OFF="-Dplatforms= -Dgallium-drivers= -Dvulkan-drivers=panfrost -Dpanfrost-rust=false -Dopengl=false -Dgles1=disabled
+	-Dgles2=disabled -Dglx=disabled -Degl=disabled -Dgbm=disabled -Dzstd=disabled -Dxmlconfig=disabled -Dexpat=disabled
+	-Dvalgrind=disabled -Dlibunwind=disabled -Dvideo-codecs= -Dbuild-tests=false"
+[ -f native/build.ninja ] || meson setup native mesa --buildtype=release $OFF -Dmesa-clc=enabled -Dinstall-mesa-clc=true \
+	-Dprecomp-compiler=enabled -Dinstall-precomp-compiler=true -Dllvm=enabled -Dshared-llvm=enabled \
+	-Dc_args="-I$B/hoststub" -Dcpp_args="-I$B/hoststub" > native-setup.log
+ninja -C native src/compiler/clc/mesa_clc src/compiler/spirv/vtn_bindgen2 src/panfrost/clc/panfrost_compile > native-ninja.log
+ln -sf "$B/native/src/compiler/clc/mesa_clc" "$B/native/src/compiler/spirv/vtn_bindgen2" \
+	"$B/native/src/panfrost/clc/panfrost_compile" hostbin/
+
+cat > cross.ini <<INI
+[binaries]
+c = ['$ROOT/xnu-deps/host/bin/xnu-clang', '-arch', 'arm64', '-isysroot', '$SDK']
+cpp = ['$ROOT/xnu-deps/host/bin/xnu-clang++', '-arch', 'arm64', '-isysroot', '$SDK', '-fuse-cxa-atexit']
+objc = ['$ROOT/xnu-deps/host/bin/xnu-clang', '-arch', 'arm64', '-isysroot', '$SDK']
+ar = 'llvm-ar'
+ranlib = 'llvm-ranlib'
+strip = 'llvm-strip'
+pkg-config = 'false'
+
+[host_machine]
+system = 'darwin'
+subsystem = 'ios'
+cpu_family = 'aarch64'
+cpu = 'arm64'
+endian = 'little'
+
+[properties]
+needs_exe_wrapper = true
+INI
+# hakios-panthor, the libdrm PanVK is built against and linked with
+SHIM=$ROOT/tools/mesa/hakios-panthor
+xnu-clang -arch arm64 -isysroot "$SDK" -O2 -Wall -I"$B/mesa/include" -c -o hakios.panthor.o "$SHIM/hakios.panthor.c"
+llvm-ar rcs libhakios_panthor.a hakios.panthor.o
+[ -f ios/build.ninja ] || meson setup ios mesa --cross-file cross.ini --wrap-mode=nofallback --prefix=/redwood \
+	--libdir=lib --buildtype=release -Db_ndebug=true $OFF -Dmesa-clc=system -Dprecomp-compiler=system -Dllvm=disabled \
+	-Dshader-cache=disabled -Dglvnd=disabled -Dtools= -Dc_args="-I$SHIM" -Dcpp_args="-I$SHIM" \
+	-Dc_link_args="$B/libhakios_panthor.a -framework IOKit" -Dcpp_link_args="$B/libhakios_panthor.a -framework IOKit" \
+	> ios-setup.log
+touch mesa/src/panfrost/vulkan/panvk_instance.c       # (relinks with a new libhakios_panthor.a)
+ninja -C ios src/panfrost/vulkan/libvulkan_panfrost.dylib > ios-ninja.log
+cp ios/src/panfrost/vulkan/libvulkan_panfrost.dylib out/
+install_name_tool -id /redwood/lib/libvulkan_panfrost.dylib out/libvulkan_panfrost.dylib
+echo "mk-panvk.sh: PanVK (Mesa $COMMIT): $B/out/libvulkan_panfrost.dylib ($(stat -f %z out/libvulkan_panfrost.dylib) bytes);" \
+	"libdrm's functions left undefined: $(nm -u out/libvulkan_panfrost.dylib | grep -c '^_drm')"

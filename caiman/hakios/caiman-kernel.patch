+void
+IOMobileFramebuffer::flipInit(void)
+{
+	IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	OSData * data = chosen ? OSDynamicCast(OSData, chosen->getProperty("fb-flip")) : NULL;
+	const uint64_t * at;
+	size_t size = (size_t) fRowBytes * fPanelHeight;

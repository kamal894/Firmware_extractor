  * as long as the steps and the watch after them last, nothing else writes to the log, so that
  * its end -- all that the loader's notes keep -- is about what is being done here.
  */
+/*
+ * boot-arg mali=1: the Pixel 9 Pro's Mali-G715 for HakiosGPU (drivers/gpu/hakios.gpu.cpp), whose requests come
+ * here as the hakios_gpu_*() calls below when mali_kept. The caiman loader (probe/gpu.c, PROBE_GPU=6, MALI_FW=)
+ * has powered the GPU, booted its CSF firmware in address space 0, started command stream group 0 / stream 0
+ * in address space 1 and run a compute shader and a triangle on it, all in memory outside the kernel's
+ * (0xf0000000 up); /chosen/mali-handoff says where: the firmware's shared interface, the stream's ring and
+ * queue pages, the AS1 page at VA 0x200000 (fences live at +0xc00 of it), the ring's INSERT, AS1's level-0
+ * table, and the free DRAM after the loader's allocations, which becomes AS1's further page tables here.
+ *
+ * - addresses: AS1 VAs from 4 GiB up, in 64 KiB steps (hakios_gpu_address);
+ * - mapping: 4 KiB AArch64 entries as kbase writes them (entry_set_ate: type 3, AF, AP read/write or read only,
+ *   MEMATTR slot 5 = 0x4c non-cacheable, executable), then a FLUSH_MEM of AS1;
+ * - streams: group 0 has three (the loader's step 9, PanVK's layout: vertex-tiler, fragment, compute), each with
+ *   its ring, queue pages, doorbell s + 1 and fence word (AS1 0x200c00 + 4 s);
+ * - submission on a stream: the caches flushed and invalidated (FLUSH_CACHE2, as Panthor does before calling a
+ *   user stream), then for each command buffer MOVE48 r92:r93 = its address, MOVE32 r94 = its length in bytes,
+ *   CALL; then the fence: MOVE48 r92:r93 = the fence's VA, MOVE32 r94 = the number, STORE_MULTIPLE, WAIT;
+ *   INSERT up and the doorbells as the loader rings them (the stream's bell, the group's bit for it, bell 0);
+ * - done: every stream's fence word has reached the number or the last number given to that stream.
+ * r92-r95 are the kernel's registers (Panthor's convention: the last four of the 96, docs/panvk-uapi.md).
+ */
+#define MALI_PHYS               0x1f000000UL
+#define MALI_DOORBELL(n)        (0x80000u + (n) * 0x10000u)
+#define MALI_AS1                0x2440u
+#define MALI_RING_SIZE          0x1000u
+#define MALI_FENCE_VA           0x200c00u
+/* the kernel's addresses: the upper half of the 48-bit space, as Panthor keeps it; the lower is PanVK's (VM bind) */
+#define MALI_VA_START           0x800000000000ull
+#define MALI_VA_SIZE            0x1000000000ull
+#define MALI_USER_VA_END        0x800000000000ull
+#define MALI_TABLES             512
+
+static vm_offset_t mali_regs, mali_bell0;
+static volatile uint32_t *mali_glb_in, *mali_glb_out, *mali_csg_in, *mali_csg_out;
+#define MALI_STREAMS            3
+static struct mali_stream {
+	vm_offset_t bell;
+	volatile uint64_t *ring, *q_in, *q_out;
+	volatile uint32_t *fence_word;
+	uint64_t ring_size, insert;
+	uint32_t last;                          /* the last fence given to this stream */
+} mali_stream[MALI_STREAMS];
+static uint64_t mali_pool_next, mali_pool_end, mali_va_next = MALI_VA_START;
+static struct {
+	uint64_t pa;
+	vm_offset_t va;
+} mali_table[MALI_TABLES];
+static unsigned mali_tables;
+
+static inline uint32_t
+mali_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(mali_regs + off);
+}
+
+static inline void
+mali_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(mali_regs + off) = v;
+}
+
+/* a table page of AS1 by its physical address: the loader's, or one taken from the free pool */
+/*
+ * Tables in the loader's pool (all but none: the pool is where they all come from) are found by their 16 KiB chunk
+ * of it, each chunk mapped once: a list searched one by one was too slow, and too short, for PanVK's address space.
+ */
+#define MALI_POOL_CHUNKS        4096
+static uint64_t mali_pool_base;
+static vm_offset_t mali_pool_chunk[MALI_POOL_CHUNKS];
+
+static volatile uint64_t *
+mali_table_va(uint64_t pa)
+{
+	if (mali_pool_base != 0 && pa >= mali_pool_base && pa < mali_pool_end &&
+	    (pa - mali_pool_base) >> 14 < MALI_POOL_CHUNKS) {
+		uint64_t c = (pa - mali_pool_base) >> 14;
+
+		if (mali_pool_chunk[c] == 0) {
+			mali_pool_chunk[c] = ml_io_map((vm_offset_t)(mali_pool_base + (c << 14)), 0x4000);
+		}
+		return (volatile uint64_t *)(mali_pool_chunk[c] + (pa & 0x3fff));
+	}
+	for (unsigned i = 0; i < mali_tables; i++) {
+		if (mali_table[i].pa == pa) {
+			return (volatile uint64_t *)mali_table[i].va;
+		}
+	}
+	if (mali_tables == MALI_TABLES) {
+		return NULL;
+	}
+	mali_table[mali_tables].pa = pa;
+	mali_table[mali_tables].va = ml_io_map((vm_offset_t)(pa & ~0x3fffull), 0x4000) + (pa & 0x3fff);
+	return (volatile uint64_t *)mali_table[mali_tables++].va;
+}
+
+static uint64_t
+mali_table_new(void)
+{
+	uint64_t pa = mali_pool_next;
+	volatile uint64_t *t;
+
+	if (pa + 0x1000 > mali_pool_end) {
+		return 0;
+	}
+	mali_pool_next += 0x1000;
+	t = mali_table_va(pa);
+	if (t == NULL) {
+		return 0;
+	}
+	for (int i = 0; i < 512; i++) {
+		t[i] = 0;
+	}
+	return pa;
+}
+
+static uint64_t mali_as1_root;
+
+static bool
+mali_space_map(uint64_t va, uint64_t pa, uint64_t attr)
+{
+	uint64_t t = mali_as1_root;
+
+	for (int level = 0; level < 3; level++) {
+		volatile uint64_t *table = mali_table_va(t);
+		unsigned idx = (unsigned)((va >> (39 - 9 * level)) & 0x1ff);
+
+		if (table == NULL) {
+			return false;
+		}
+		if (!(table[idx] & 1)) {
+			uint64_t next = mali_table_new();
+
+			if (next == 0) {
+				return false;
+			}
+			table[idx] = next | 0x403;
+		}
+		t = table[idx] & 0xfffffffff000ull;
+	}
+	mali_table_va(t)[(va >> 12) & 0x1ff] = pa ? (pa | attr) : 0;
+	return true;
+}
+
+static void
+mali_as1_flush(void)
+{
+	__builtin_arm_dsb(0xf);
+	for (int i = 0; i < 100000 && (mali_rd(MALI_AS1 + 0x28) & 1); i++) {
+	}
+	mali_wr(MALI_AS1 + 0x18, 5);                    /* FLUSH_MEM */
+	for (int i = 0; i < 100000 && (mali_rd(MALI_AS1 + 0x28) & 1); i++) {
+	}
+}
+
+static uint64_t
+mali_address(uint64_t size)
+{
+	uint64_t address = mali_va_next;
+
+	size = (size + 0xffff) & ~0xffffull;
+	if (address + size > MALI_VA_START + MALI_VA_SIZE) {
+		return 0;
+	}
+	mali_va_next += size;
+	return address;
+}
+
+static bool
+mali_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return mali_space_map(address, phys, 3 | (1u << 10) | (read_only ? 3u << 6 : 1u << 6) | (5u << 2));
+}
+
+static uint32_t
+mali_submit_on(unsigned st, const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	struct mali_stream *q = &mali_stream[st];
+	uint32_t n = 3 * count + 16, i;
+	uint64_t deadline;
+
+	clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+	while (q->insert + n * 8 + 64 - q->q_out[0] > q->ring_size) {
+		if (mach_absolute_time() > deadline) {
+			return 0;
+		}
+		delay(100);
+	}
+	if (++mali_fence == 0) {
+		mali_fence = 1;
+	}
+#define MALI_RING(w) do { q->ring[(q->insert / 8) % (q->ring_size / 8)] = (w); q->insert += 8; } while (0)
+	MALI_RING((0x02ULL << 56) | (95ULL << 48));                                 /* MOVE32 r95 = 0: flush always */
+	MALI_RING((0x24ULL << 56) | (95ULL << 40) | 0x233);                         /* FLUSH_CACHE2 L2, LSC, other */
+	MALI_RING((0x03ULL << 56) | (1ULL << 16));                                  /* WAIT slot 0 */
+	for (i = 0; i < count; i++) {
+		MALI_RING((0x01ULL << 56) | (92ULL << 48) | (addresses[i] & 0xffffffffffffULL));
+		MALI_RING((0x02ULL << 56) | (94ULL << 48) | (uint64_t)words[i] * 4);
+		MALI_RING((0x20ULL << 56) | (92ULL << 40) | (94ULL << 32));            /* CALL */
+	}
+	MALI_RING((0x01ULL << 56) | (92ULL << 48) | (MALI_FENCE_VA + 4 * st));
+	MALI_RING((0x02ULL << 56) | (94ULL << 48) | mali_fence);
+	MALI_RING((0x1cULL << 56) | (1ULL << 32));                                  /* SB_SEL_OTHER 0 */
+	MALI_RING((0x15ULL << 56) | (94ULL << 48) | (92ULL << 40) | (1ULL << 16));  /* STORE_MULTIPLE r94 -> [r92] */
+	MALI_RING((0x03ULL << 56) | (0xffffULL << 16));                             /* WAIT all */
+	while (q->insert % 64) {
+		MALI_RING(0);
+	}
+#undef MALI_RING
+	q->last = mali_fence;
+	__builtin_arm_dsb(0xf);
+	q->q_in[0] = q->insert;
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)q->bell = 1;
+	mali_csg_in[2] = (mali_csg_in[2] & ~(1u << st)) | ((mali_csg_out[2] ^ (1u << st)) & (1u << st));
+	mali_glb_in[2] = (mali_glb_in[2] & ~1u) | ((mali_glb_out[2] ^ 1u) & 1u);
+	__builtin_arm_dsb(0xf);
+	*(volatile uint32_t *)mali_bell0 = 1;
+	return mali_fence;
+}
+
+/* HakiosGPU's submissions: on stream 0 */
+static uint32_t
+mali_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	return mali_submit_on(0, addresses, words, count);
+}
+
+static bool
+mali_done(uint32_t fence)
+{
+	/* the firmware's job interrupts, cleared, and group 0's requests acknowledged (as the loader's gpu_service) */
+	uint32_t raw = mali_rd(0x1000);
+
+	if (raw) {
+		mali_wr(0x1004, raw);
+	}
+	mali_csg_in[3] = mali_csg_out[3];
+	for (unsigned st = 0; st < MALI_STREAMS; st++) {
+		uint32_t need = (int32_t)(mali_stream[st].last - fence) < 0 ? mali_stream[st].last : fence;
+
+		if (mali_stream[st].ring != NULL && need != 0 && (int32_t)(*mali_stream[st].fence_word - need) < 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * A tiler heap, as Panthor's TILER_HEAP_CREATE gives PanVK one (docs/panvk-uapi.md), in kbase's format (the
+ * loader's step 11 drew a triangle with it): `count` chunks of `chunk_size` bytes of wired kernel memory, each
+ * mapped at consecutive AS1 addresses, each starting with a 64-byte header whose first u64 points at the next
+ * ((address & ~0xfff) | size >> 12; 0 for the last), and a 32-byte heap context pointing at the first. Returns
+ * the context's GPU address (for HEAP_SET) and the first chunk's (for the Tiler Heap descriptor); 0: no memory.
+ * Chunks are never added on out-of-memory events yet: enough are given at the start.
+ */
+static uint64_t
+mali_tiler_heap_create(uint32_t chunk_size, uint32_t count, uint64_t *first_chunk)
+{
+	vm_offset_t ctx_page = 0;
+	uint64_t ctx_va, chunk_va = 0, prev_hdr_kva = 0, first = 0;
+
+	if (chunk_size < 0x10000 || (chunk_size & 0xfff) || count == 0 ||
+	    kmem_alloc(kernel_map, &ctx_page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	ctx_va = mali_address(PAGE_SIZE);
+	for (uint64_t off = 0; off < PAGE_SIZE; off += 4096) {
+		mali_map(ctx_va + off, kvtophys(ctx_page + off), false);
+	}
+	for (uint32_t c = 0; c < count; c++) {
+		vm_offset_t chunk = 0;
+		uint64_t va = mali_address(chunk_size);
+
+		if (va == 0 || kmem_alloc(kernel_map, &chunk, chunk_size, KMA_KOBJECT | KMA_ZERO,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return 0;
+		}
+		for (uint64_t off = 0; off < chunk_size; off += 4096) {
+			if (!mali_map(va + off, kvtophys(chunk + off), false)) {
+				return 0;
+			}
+		}
+		if (prev_hdr_kva) {
+			*(volatile uint64_t *)prev_hdr_kva = va | (chunk_size >> 12);
+			hakios_gpu_to_memory((void *)prev_hdr_kva, 64);
+		} else {
+			first = va;
+		}
+		prev_hdr_kva = chunk;
+		chunk_va = va;
+	}
+	(void)chunk_va;
+	*(volatile uint64_t *)ctx_page = first | (chunk_size >> 12);
+	hakios_gpu_to_memory((void *)ctx_page, 64);
+	mali_as1_flush();
+	*first_chunk = first;
+	return ctx_va;
+}
+
+/* The API, used the way HakiosGPU's client uses it: a command buffer in a kernel page, mapped, submitted, waited for. */
+static void
+mali_self_test(void)
+{
+	vm_offset_t page = 0;
+	uint64_t phys, address, deadline, heap_ctx, heap_first = 0;
+	volatile uint64_t *cmd;
+	volatile uint32_t *data;
+	uint32_t fence, words;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("mali: self test: no page\n");
+		return;
+	}
+	phys = kvtophys(page);
+	address = mali_address(PAGE_SIZE);
+	for (uint64_t off = 0; off < PAGE_SIZE; off += 4096) {
+		if (!mali_map(address + off, phys + off, false)) {
+			printf("mali: self test: no page tables left\n");
+			return;
+		}
+	}
+	mali_as1_flush();
+	cmd = (volatile uint64_t *)page;
+	data = (volatile uint32_t *)(page + 0x800);
+	*data = 0;
+	cmd[0] = (0x01ULL << 56) | (0ULL << 48) | (address + 0x800);                   /* MOVE48 r0:r1 */
+	cmd[1] = (0x02ULL << 56) | (2ULL << 48) | 0xc0ffee11;                          /* MOVE32 r2 */
+	cmd[2] = (0x1cULL << 56) | (1ULL << 32);
+	cmd[3] = (0x15ULL << 56) | (2ULL << 48) | (0ULL << 40) | (1ULL << 16);         /* STORE_MULTIPLE */
+	cmd[4] = (0x03ULL << 56) | (1ULL << 16);                                       /* WAIT */
+	words = 5 * 2;
+	hakios_gpu_to_memory((void *)page, PAGE_SIZE);
+	for (unsigned st = 0; st < MALI_STREAMS; st++) {
+		*data = 0;
+		cmd[1] = (0x02ULL << 56) | (2ULL << 48) | (0xc0ffee10 + st);
+		hakios_gpu_to_memory((void *)page, PAGE_SIZE);
+		fence = mali_submit_on(st, &address, &words, 1);
+		clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+		while (fence && !mali_done(fence) && mach_absolute_time() < deadline) {
+			delay(10);
+		}
+		hakios_gpu_to_memory((void *)(page + 0x800), 64);
+		if (st == 2) {
+			break;
+		}
+		printf("mali: self test, stream %u: a command buffer in kernel memory (phys %#llx) at GPU address %#llx, fence "
+		    "%u %s; it wrote %#x%s\n", st, phys, address, fence, fence && mali_done(fence) ? "done" : "NOT done", *data,
+		    *data == 0xc0ffee10 + st ? ": OK" : "");
+	}
+	printf("mali: self test, stream 2: fence %u %s, wrote %#x%s\n", fence, fence && mali_done(fence) ? "done" : "NOT done",
+	    *data, *data == 0xc0ffee12 ? ": OK" : "");
+
+	/* a tiler heap as PanVK asks for one (5 chunks of 2 MiB), then HEAP_SET with it on stream 0 */
+	heap_ctx = mali_tiler_heap_create(2 * 1024 * 1024, 5, &heap_first);
+	if (heap_ctx != 0) {
+		cmd[0] = (0x01ULL << 56) | (0ULL << 48) | heap_ctx;                     /* MOVE48 r0:r1 = the context */
+		cmd[1] = (0x30ULL << 56) | (0ULL << 40);                                  /* HEAP_SET */
+		cmd[2] = (0x01ULL << 56) | (2ULL << 48) | (address + 0x800);              /* MOVE48 r2:r3 */
+		cmd[3] = (0x02ULL << 56) | (4ULL << 48) | 0x4ea90001;                     /* MOVE32 r4 */
+		cmd[4] = (0x1cULL << 56) | (1ULL << 32);
+		cmd[5] = (0x15ULL << 56) | (4ULL << 48) | (2ULL << 40) | (1ULL << 16);    /* STORE r4 -> [r2] */
+		cmd[6] = (0x03ULL << 56) | (1ULL << 16);
+		words = 7 * 2;
+		*data = 0;
+		hakios_gpu_to_memory((void *)page, PAGE_SIZE);
+		fence = mali_submit_on(0, &address, &words, 1);
+		clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+		while (fence && !mali_done(fence) && mach_absolute_time() < deadline) {
+			delay(10);
+		}
+		hakios_gpu_to_memory((void *)(page + 0x800), 64);
+	}
+	printf("mali: self test, tiler heap: context at GPU %#llx, first chunk %#llx (5 x 2 MiB); HEAP_SET then a store: %#x%s\n",
+	    heap_ctx, heap_first, *data, *data == 0x4ea90001 ? ": OK" : "");
+}
+
+/* For HakiosGPU's Mali requests (hakios.gpu.cpp kMaliQuery, kMaliSubmit, kMaliTilerHeap); false / 0 without mali=1 */
+bool hakios_mali_query(uint32_t *w32, uint64_t *w64);
+uint32_t hakios_mali_submit(uint32_t queue, uint64_t address, uint32_t bytes);
+uint64_t hakios_mali_tiler_heap(uint32_t chunk_size, uint32_t chunks, uint64_t *first_chunk);
+
+/* w32: GPU_ID, L2/CORE/TILER/MEM/MMU features, AS_PRESENT, CSF_ID; w64: shader, tiler, L2 present; then w32 again
+ * (after w64 in struct mali_query): CSG slots, CS slots, CS registers, scoreboards, kernel registers, timestamp Hz */
+bool
+hakios_mali_query(uint32_t *w32, uint64_t *w64)
+{
+	static const uint16_t regs[8] = { 0x0, 0x4, 0x8, 0xc, 0x10, 0x14, 0x18, 0x1c };
+	uint32_t *tail = (uint32_t *)(w64 + 3), cs_features = 0x7105f;
+
+	if (!mali_kept) {
+		return false;
+	}
+	for (int i = 0; i < 8; i++) {
+		w32[i] = mali_rd(regs[i]);
+	}
+	w64[0] = (uint64_t)mali_rd(0x104) << 32 | mali_rd(0x100);
+	w64[1] = (uint64_t)mali_rd(0x114) << 32 | mali_rd(0x110);
+	w64[2] = (uint64_t)mali_rd(0x124) << 32 | mali_rd(0x120);
+	tail[0] = 8;                                    /* CSG slots (the firmware's interface) */
+	tail[1] = MALI_STREAMS;                         /* streams of group 0 */
+	tail[2] = (cs_features & 0xff) + 1;             /* 96 registers (CS features 0x7105f, run gpu20) */
+	tail[3] = (cs_features >> 8) & 0xff;            /* 16 scoreboards */
+	tail[4] = 4;                                    /* r92-r95 are the kernel's */
+	tail[5] = 24576000;                             /* the system timestamp */
+	return true;
+}
+
+uint32_t
+hakios_mali_submit(uint32_t queue, uint64_t address, uint32_t bytes)
+{
+	uint32_t words = bytes / 4;
+
+	if (!mali_kept || queue >= MALI_STREAMS || mali_stream[queue].ring == NULL || (address & 63) || (bytes & 7)) {
+		return 0;
+	}
+	return mali_submit_on(queue, &address, &words, 1);
+}
+
+/*
+ * Panthor's VM_BIND for PanVK, one page at a time: `phys` at the user address `va` (below MALI_USER_VA_END, where
+ * the kernel never puts anything of its own above the loader's first 32 MiB), or nothing there (phys 0). Then
+ * hakios_mali_bound() to make the GPU see the changes.
+ */
+bool hakios_mali_bind_page(uint64_t va, uint64_t phys, bool read_only);
+void hakios_mali_bound(void);
+bool hakios_mali_register(uint32_t offset, uint32_t *value);
+
+/* A GPU_CONTROL identification register for user space (Panthor's GPU_INFO): the read-only ones only, 0x000-0x12c
+ * (IDs, features, thread and texture properties, the timestamp, the present masks) and COHERENCY_FEATURES 0x300 */
+bool
+hakios_mali_register(uint32_t offset, uint32_t *value)
+{
+	if (!mali_kept || (offset & 3) || (offset >= 0x130 && offset != 0x300) || (offset >= 0x30 && offset < 0x60)) {
+		return false;
+	}
+	*value = mali_rd(offset);
+	return true;
+}
+
+bool
+hakios_mali_bind_page(uint64_t va, uint64_t phys, bool read_only)
+{
+	if (!mali_kept || va < 0x2000000 || va >= MALI_USER_VA_END || (va & 0xfff)) {
+		return false;
+	}
+	return phys ? mali_map(va, phys, read_only) : mali_space_map(va, 0, 0);
+}
+
+void
+hakios_mali_bound(void)
+{
+	if (mali_kept) {
+		mali_as1_flush();
+	}
+}
+
+uint64_t
+hakios_mali_tiler_heap(uint32_t chunk_size, uint32_t chunks, uint64_t *first_chunk)
+{
+	return mali_kept ? mali_tiler_heap_create(chunk_size, chunks, first_chunk) : 0;
+}
+
+static void
+mali_handoff(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+	const uint64_t *h;
+	vm_offset_t shared, queue, target;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "mali-handoff", &prop, &size) != kSuccess || size != 20 * sizeof(uint64_t)) {
+		printf("mali: no /chosen/mali-handoff from the loader\n");
+		return;
+	}
+	h = prop;
+	mali_regs = ml_io_map(MALI_PHYS, 0x4000);
+	mali_bell0 = ml_io_map(MALI_PHYS + MALI_DOORBELL(0), 0x4000);
+	shared = ml_io_map(h[0], 0x10000);
+	target = ml_io_map(h[3], 0x4000);
+	for (unsigned st = 0; st < MALI_STREAMS; st++) {
+		const uint64_t *hs = h + 8 + 4 * st;
+		struct mali_stream *q = &mali_stream[st];
+
+		if (hs[0] == 0) {
+			continue;
+		}
+		q->bell = ml_io_map(MALI_PHYS + MALI_DOORBELL(st + 1), 0x4000);
+		q->ring = (volatile uint64_t *)ml_io_map(hs[0], hs[1] < 0x4000 ? 0x4000 : hs[1]);
+		q->ring_size = hs[1];
+		queue = ml_io_map(hs[2], 0x4000);
+		q->q_in = (volatile uint64_t *)queue;
+		q->q_out = (volatile uint64_t *)(queue + 0x1000);       /* (4 KiB pages: the loader's, not the kernel's 16 KiB) */
+		q->insert = hs[3];
+		q->fence_word = (volatile uint32_t *)(target + 0xc00 + 4 * st);
+		*q->fence_word = 0;
+	}
+	mali_as1_root = h[5];
+	mali_pool_next = h[6];
+	mali_pool_end = h[7];
+	mali_pool_base = h[6] & ~0x1ffffffull;          /* the loader's pool: 32 MiB at a 32 MiB boundary */
+	mali_glb_in = (volatile uint32_t *)(shared + (*(volatile uint32_t *)(shared + 8) - 0x04000000));
+	mali_glb_out = (volatile uint32_t *)(shared + (*(volatile uint32_t *)(shared + 0xc) - 0x04000000));
+	mali_csg_in = (volatile uint32_t *)(shared + (*(volatile uint32_t *)(shared + 0x1004) - 0x04000000));
+	mali_csg_out = (volatile uint32_t *)(shared + (*(volatile uint32_t *)(shared + 0x1008) - 0x04000000));
+	printf("mali: GPU_ID %#x, MCU_STATUS %u; firmware interface %#x; stream 0 insert %llu, extract %llu; streams 1, 2 "
+	    "rings %llu, %llu bytes; AS1 tables at %#llx, %llu KiB of DRAM for more\n", mali_rd(0), mali_rd(0x704),
+	    *(volatile uint32_t *)shared, mali_stream[0].insert, mali_stream[0].q_out[0], mali_stream[1].ring_size,
+	    mali_stream[2].ring_size, mali_as1_root, (mali_pool_end - mali_pool_next) / 1024);
+	mali_kept = true;
+	mali_self_test();
+	HakiosGPUStart();
+}

+	/* front, back, the display's address register, the controller's update request register, its frame counter */
+	if (data == NULL || data->getLength() != 5 * sizeof(uint64_t)) {
+		IOLog("MiniIOMobileFramebuffer: fb_flip: no fb-flip from the loader; one buffer\n");
+		OSSafeReleaseNULL(chosen);
+		return;
+	}
+	at = (const uint64_t *) data->getBytesNoCopy();
+	fFlipPhysical[0] = at[0];
+	fFlipPhysical[1] = at[1];
+	fFlipBuffer[0] = fBase;
+	/* as the console maps the first (video_console.c): write-combined, out of the way of io_map's small range */
+	fFlipBuffer[1] = (uint8_t *) ml_io_map_unmappable((vm_offset_t) at[1], round_page(size), 0x6 /* VM_WIMG_WCOMB */);
+	fFlipAddress = (volatile uint32_t *) (ml_io_map((vm_offset_t) trunc_page(at[2]), PAGE_SIZE) + (at[2] & PAGE_MASK));
+	fFlipUpdate = (volatile uint32_t *) (ml_io_map((vm_offset_t) trunc_page(at[3]), PAGE_SIZE) + (at[3] & PAGE_MASK));
+	fFlipFrames = (volatile uint32_t *) (ml_io_map((vm_offset_t) trunc_page(at[4]), PAGE_SIZE) + (at[4] & PAGE_MASK));
+	OSSafeReleaseNULL(chosen);
+	if (fFlipBuffer[1] == NULL || *fFlipAddress != (uint32_t) fFlipPhysical[0]) {
+		IOLog("MiniIOMobileFramebuffer: fb_flip: the display reads %#x, not the first buffer %#llx; one buffer\n",
+		    fFlipAddress ? *fFlipAddress : 0, fFlipPhysical[0]);
+		fFlipBuffer[1] = NULL;
+		return;
+	}
+	for (uint32_t y = 0; y < fPanelHeight; y++) {
+		memcpy(fFlipBuffer[1] + (size_t) y * fRowBytes, fBase + (size_t) y * fRowBytes, (size_t) fPanelWidth * 4);

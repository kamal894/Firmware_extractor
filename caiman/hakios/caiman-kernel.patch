+	/* Panthor's VM_BIND (0x93): the buffer at an address of our own choosing, as PanVK chooses them, and used there */
+	{
+		struct { uint32_t handle, flags; uint64_t va, offset, size; } bind = { bo.handle, 0, 0x40000000, 0, 0x10000 };
+		const uint64_t va = 0x40000000;
+		volatile uint64_t *cs = (volatile uint64_t *)(uintptr_t)cpu;
+		volatile uint32_t *word = (volatile uint32_t *)(uintptr_t)(cpu + 0x800);
+		struct mali_submit s = { .queue = 2, .size = 5 * 8, .address = va };
+		struct msm_wait_fence w = { 0 };
+		struct timespec now;
+		kern_return_t kb = call(0x93, &bind, sizeof(bind));
+
+		*word = 0;
+		cs[0] = (0x01ULL << 56) | (0ULL << 48) | (va + 0x800);
+		cs[1] = (0x02ULL << 56) | (2ULL << 48) | 0xb19d0001;
+		cs[2] = (0x1cULL << 56) | (1ULL << 32);
+		cs[3] = (0x15ULL << 56) | (2ULL << 48) | (0ULL << 40) | (1ULL << 16);
+		cs[4] = (0x03ULL << 56) | (1ULL << 16);
+		__asm__ volatile("dsb sy" ::: "memory");
+		kr = kb == KERN_SUCCESS ? call(0x91, &s, sizeof(s)) : kb;
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		w.fence = s.fence;
+		w.seconds = now.tv_sec + 1;
+		w.nanoseconds = now.tv_nsec;
+		if (kr == KERN_SUCCESS) {
+			kr = call(0x47, &w, sizeof(w));
+		}
+		printf("mali_test: bound at %#llx: bind %#x, submit and wait %#x; the word is %#x%s\n", (unsigned long long)va, kb, kr,
+		    *word, *word == 0xb19d0001 ? ": THE GPU RAN FROM A USER-CHOSEN ADDRESS" : "");
+		bind.handle = 0;
+		kb = call(0x93, &bind, sizeof(bind));
+		printf("mali_test: unbound: %#x\n", kb);
+	}
+
+	struct mali_tiler_heap h = { .chunk_size = 2 * 1024 * 1024, .chunks = 5 };
+
+	kr = call(0x92, &h, sizeof(h));
+	printf("mali_test: tiler heap %#x: context %#llx, first chunk %#llx\n", kr, h.context, h.first_chunk);
+	return 0;
+}

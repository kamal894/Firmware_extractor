@@ -261,6 +261,7 @@ static TUNABLE(uint32_t, gMeasure, "fb_measure", 0);
  */
 static TUNABLE(uint32_t, gBeam, "fb_beam", 1);
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
 static inline uint32_t refreshHz(void);
 
 /*
@@ -269,6 +270,17 @@ static inline uint32_t refreshHz(void);
  * abort a minute after boot, so on a SoC not known here nothing is read and frames stay on their beat.

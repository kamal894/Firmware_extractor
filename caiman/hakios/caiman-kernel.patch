+
+static int
+dev_query(struct drm_panthor_dev_query *q)
+{
+	union {
+		struct drm_panthor_gpu_info gpu;
+		struct drm_panthor_csif_info csif;
+		struct drm_panthor_timestamp_info ts;
+		struct drm_panthor_group_priorities_info prio;
+		struct drm_panthor_mmu_info mmu;
+	} out;
+	struct k_query k = { 0 };
+	uint32_t size;
+	int error;
+
+	memset(&out, 0, sizeof(out));
+	switch (q->type) {
+	case DRM_PANTHOR_DEV_QUERY_GPU_INFO:
+		size = sizeof(out.gpu);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_CSIF_INFO:
+		size = sizeof(out.csif);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_TIMESTAMP_INFO:
+		size = sizeof(out.ts);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_GROUP_PRIORITIES_INFO:
+		size = sizeof(out.prio);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_MMU_INFO:
+		size = sizeof(out.mmu);
+		break;
+	default:
+		return EINVAL;
+	}
+	if (q->pointer == 0) {
+		q->size = size;
+		return 0;
+	}
+	if ((error = call(REQ_MALI_QUERY, &k, sizeof(k))) != 0) {
+		return error;
+	}
+	switch (q->type) {
+	case DRM_PANTHOR_DEV_QUERY_GPU_INFO:
+		out.gpu.gpu_id = k.gpu_id;
+		out.gpu.gpu_rev = 0;                    /* (GPU_REVID, 0x280, is not among the kernel's registers) */
+		out.gpu.csf_id = k.csf_id;
+		out.gpu.l2_features = k.l2_features;
+		out.gpu.tiler_features = k.tiler_features;
+		out.gpu.mem_features = k.mem_features;
+		out.gpu.mmu_features = k.mmu_features;
+		out.gpu.thread_features = reg(0xac);
+		out.gpu.max_threads = reg(0xa0);
+		out.gpu.thread_max_workgroup_size = reg(0xa4);
+		out.gpu.thread_max_barrier_size = reg(0xa8);
+		out.gpu.coherency_features = reg(0x300);
+		for (int i = 0; i < 4; i++) out.gpu.texture_features[i] = reg(0xb0 + 4 * i);
+		out.gpu.as_present = k.as_present;
+		out.gpu.selected_coherency = DRM_PANTHOR_GPU_COHERENCY_NONE;
+		out.gpu.shader_present = k.shader_present;
+		out.gpu.l2_present = k.l2_present;
+		out.gpu.tiler_present = k.tiler_present;
+		out.gpu.core_features = k.core_features;
+		out.gpu.gpu_features = (uint64_t)reg(0x64) << 32 | reg(0x60);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_CSIF_INFO:
+		out.csif.csg_slot_count = k.csg_slots;
+		out.csif.cs_slot_count = k.cs_slots;
+		out.csif.cs_reg_count = k.cs_regs;
+		out.csif.scoreboard_slot_count = k.scoreboards;
+		out.csif.unpreserved_cs_reg_count = k.unpreserved_regs;
+		break;
+	case DRM_PANTHOR_DEV_QUERY_TIMESTAMP_INFO: {
+		struct timespec t;
+		uint32_t hi, lo;
+
+		do {                                    /* the GPU's timestamp: the system counter, no offset */
+			hi = reg(0x9c);
+			lo = reg(0x98);
+		} while (reg(0x9c) != hi);
+		clock_gettime(CLOCK_MONOTONIC, &t);
+		out.ts.timestamp_frequency = k.timestamp_hz;
+		out.ts.current_timestamp = (uint64_t)hi << 32 | lo;
+		out.ts.timestamp_offset = 0;
+		out.ts.flags = DRM_PANTHOR_TIMESTAMP_GPU | DRM_PANTHOR_TIMESTAMP_CPU_MONOTONIC | DRM_PANTHOR_TIMESTAMP_GPU_OFFSET |
+		    DRM_PANTHOR_TIMESTAMP_FREQ;
+		out.ts.cpu_timestamp_sec = (uint64_t)t.tv_sec;
+		out.ts.cpu_timestamp_nsec = (uint64_t)t.tv_nsec;
+		break;
+	}
+	case DRM_PANTHOR_DEV_QUERY_GROUP_PRIORITIES_INFO:
+		out.prio.allowed_mask = (1u << PANTHOR_GROUP_PRIORITY_LOW) | (1u << PANTHOR_GROUP_PRIORITY_MEDIUM);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_MMU_INFO:
+		out.mmu.page_size_bitmap = 1u << 12;
+		break;
+	}
+	memcpy((void *)(uintptr_t)q->pointer, &out, q->size < size ? q->size : size);
+	return 0;
+}
+
+/* a submission's (or a bind's) sync operations: the waits now, the signals given FENCE */
+static int
+syncs_wait(const struct drm_panthor_obj_array *syncs)
+{
+	for (uint32_t i = 0; i < syncs->count; i++) {
+		const struct drm_panthor_sync_op *op = (const void *)(uintptr_t)(syncs->array + (uint64_t)i * syncs->stride);
+		uint32_t h = op->handle;
+		uint64_t p = (op->flags & DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK) == DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ ?
+		    op->timeline_value : 0;
+
+		if (!(op->flags & DRM_PANTHOR_SYNC_OP_SIGNAL) &&
+		    drmSyncobjTimelineWait(0, &h, &p, 1, now_ns() + 10000000000LL,
+		    DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT, NULL) != 0) {
+			return errno ? errno : ETIME;
+		}
+	}
+	return 0;
+}
+
+static void
+syncs_signal(const struct drm_panthor_obj_array *syncs, uint32_t fence)
+{
+	pthread_mutex_lock(&syncobj_lock);
+	for (uint32_t i = 0; i < syncs->count; i++) {
+		const struct drm_panthor_sync_op *op = (const void *)(uintptr_t)(syncs->array + (uint64_t)i * syncs->stride);
+		bool timeline = (op->flags & DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK) == DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ;
+		struct syncobj *s = syncobj_of(op->handle);
+
+		if (!(op->flags & DRM_PANTHOR_SYNC_OP_SIGNAL) || s == NULL) {
+			continue;
+		}
+		if (!timeline) {
+			s->reached = 0, s->pending = 0;         /* a binary one: what it holds now is this */
+		}
+		syncobj_add(s, timeline ? op->timeline_value : 1, fence);
+	}
+	pthread_cond_broadcast(&syncobj_submitted);
+	pthread_mutex_unlock(&syncobj_lock);
+}
+
+static int
+vm_bind(struct drm_panthor_vm_bind *b)
+{
+	for (uint32_t i = 0; i < b->ops.count; i++) {
+		struct drm_panthor_vm_bind_op *op = (void *)(uintptr_t)(b->ops.array + (uint64_t)i * b->ops.stride);
+		uint32_t type = op->flags & DRM_PANTHOR_VM_BIND_OP_TYPE_MASK;
+		int error = syncs_wait(&op->syncs);
+
+		if (error != 0) {
+			b->ops.count = i;
+			return error;
+		}
+		if (type == DRM_PANTHOR_VM_BIND_OP_TYPE_MAP || type == DRM_PANTHOR_VM_BIND_OP_TYPE_UNMAP) {
+			struct k_bind k = {
+				.handle = type == DRM_PANTHOR_VM_BIND_OP_TYPE_MAP ? op->bo_handle : 0,
+				.flags = (op->flags & DRM_PANTHOR_VM_BIND_OP_MAP_READONLY) ? 1 : 0,
+				/* (a size of part of a page means the whole page, as Panthor takes it: PanVK binds small BOs so) */
+				.va = op->va, .offset = op->bo_offset, .size = (op->size + 4095) & ~4095ull,
+			};
+
+			if (op->flags & DRM_PANTHOR_VM_BIND_OP_MAP_SPARSE) {
+				say_once("sparse binding");
+				error = ENOSYS;
+			} else {
+				error = call(REQ_MALI_BIND, &k, sizeof(k));
+			}
+			if (tracing() && (error != 0 || i < 4)) {
+				fprintf(stderr, "hakios-panthor: bind op %u: %s handle %u flags %#x va %#llx offset %#llx size %#llx: %s\n", i,
+				    type == DRM_PANTHOR_VM_BIND_OP_TYPE_MAP ? "map" : "unmap", op->bo_handle, op->flags,
+				    (unsigned long long)op->va, (unsigned long long)op->bo_offset, (unsigned long long)op->size,
+				    error ? strerror(error) : "ok");
+			}
+			if (error != 0) {
+				b->ops.count = i;
+				return error;
+			}
+		}
+		syncs_signal(&op->syncs, 0);            /* done now */
+	}
+	return 0;
+}
+
+static int
+group_submit(struct drm_panthor_group_submit *g)
+{
+	for (uint32_t i = 0; i < g->queue_submits.count; i++) {
+		struct drm_panthor_queue_submit *q = (void *)(uintptr_t)(g->queue_submits.array + (uint64_t)i * g->queue_submits.stride);
+		uint32_t fence;
+		int error = syncs_wait(&q->syncs);
+
+		if (error != 0) {
+			return error;
+		}
+		if (q->stream_size == 0) {
+			/* only syncs: done when everything submitted before it is (the kernel's done() is over all streams) */
+			fence = __atomic_load_n(&last_fence, __ATOMIC_ACQUIRE);
+		} else {
+			struct k_submit k = { .queue = q->queue_index, .size = q->stream_size, .address = q->stream_addr };
+
+			if ((error = call(REQ_MALI_SUBMIT, &k, sizeof(k))) != 0) {
+				return error;
+			}
+			fence = k.fence;
+			__atomic_store_n(&last_fence, fence, __ATOMIC_RELEASE);
+		}
+		syncs_signal(&q->syncs, fence);
+	}
+	return 0;
+}
+
+static uint32_t next_group = 1, next_heap = 1;
+static uint32_t bo_flags[8192 + 1];
+
+static int
+panthor(unsigned id, void *arg)
+{
+	switch (id) {
+	case DRM_PANTHOR_DEV_QUERY:
+		return dev_query(arg);
+	case DRM_PANTHOR_VM_CREATE: {
+		struct drm_panthor_vm_create *v = arg;
+
+		v->id = 1;                              /* the one user address space: the kernel's */
+		return 0;
+	}
+	case DRM_PANTHOR_VM_DESTROY:
+		return 0;
+	case DRM_PANTHOR_VM_BIND:
+		return vm_bind(arg);
+	case DRM_PANTHOR_VM_GET_STATE:
+		((struct drm_panthor_vm_get_state *)arg)->state = DRM_PANTHOR_VM_STATE_USABLE;
+		return 0;
+	case DRM_PANTHOR_BO_CREATE: {
+		struct drm_panthor_bo_create *c = arg;
+		struct k_gem_new k = { .size = c->size, .flags = MSM_BO_WC };
+		int error = call(REQ_GEM_NEW, &k, sizeof(k));
+
+		if (error == 0) {
+			c->handle = k.handle;
+			if (k.handle <= 8192) bo_flags[k.handle] = c->flags;
+		}
+		return error;
+	}
+	case DRM_PANTHOR_BO_MMAP_OFFSET: {
+		struct drm_panthor_bo_mmap_offset *m = arg;
+
+		m->offset = (uint64_t)m->handle << 32;  /* (hakios_panthor_mmap's) */
+		return 0;
+	}
+	case DRM_PANTHOR_GROUP_CREATE: {
+		struct drm_panthor_group_create *c = arg;
+
+		if (c->queues.count > 3) {
+			say_once("a group of more than 3 queues");
+			return EINVAL;
+		}
+		c->group_handle = __atomic_fetch_add(&next_group, 1, __ATOMIC_RELAXED);
+		return 0;
+	}
+	case DRM_PANTHOR_GROUP_DESTROY:
+		return 0;
+	case DRM_PANTHOR_GROUP_SUBMIT:
+		return group_submit(arg);
+	case DRM_PANTHOR_GROUP_GET_STATE: {
+		struct drm_panthor_group_get_state *s = arg;
+
+		s->state = 0;
+		s->fatal_queues = 0;
+		return 0;
+	}
+	case DRM_PANTHOR_TILER_HEAP_CREATE: {
+		struct drm_panthor_tiler_heap_create *c = arg;
+		struct k_heap k = { .chunk_size = c->chunk_size, .chunks = c->initial_chunk_count };
+		int error = call(REQ_MALI_HEAP, &k, sizeof(k));
+
+		if (error == 0) {
+			c->handle = __atomic_fetch_add(&next_heap, 1, __ATOMIC_RELAXED);
+			c->tiler_heap_ctx_gpu_va = k.context;
+			c->first_heap_chunk_gpu_va = k.first_chunk;
+		}
+		return error;
+	}
+	case DRM_PANTHOR_TILER_HEAP_DESTROY:            /* (its memory is the kernel's until the next boot) */
+	case DRM_PANTHOR_BO_SET_LABEL:
+	case DRM_PANTHOR_SET_USER_MMIO_OFFSET:
+	case DRM_PANTHOR_BO_SYNC:                       /* (write-combined: nothing of the processor's to push out) */
+		return 0;
+	case DRM_PANTHOR_BO_QUERY_INFO: {
+		struct drm_panthor_bo_query_info *q = arg;
+
+		q->extra_flags = 0;
+		q->create_flags = q->handle <= 8192 ? bo_flags[q->handle] : 0;
+		return 0;
+	}
+	default:
+		say_once("a Panthor request");
+		return ENOSYS;
+	}
+}
+
+int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+	unsigned nr = (unsigned)(request & 0xff);
+	int error;
+
+	(void)fd;
+	if (nr == REQ_GEM_CLOSE) {
+		struct drm_gem_close *c = arg;
+		return drmCloseBufferHandle(fd, c->handle);
+	}
+	if (nr < DRM_COMMAND_BASE || nr > DRM_COMMAND_BASE + DRM_PANTHOR_BO_QUERY_INFO) {
+		say_once("a DRM request");
+		return fail(ENOSYS);
+	}
+	error = panthor(nr - DRM_COMMAND_BASE, arg);
+	trace("Panthor request", nr - DRM_COMMAND_BASE, error);
+	return error ? fail(error) : 0;
+}
+
+int
+drmCommandWrite(int fd, unsigned long index, const void *data, unsigned long size)
+{
+	(void)size;
+	return drmIoctl(fd, DRM_COMMAND_BASE + index, (void *)(uintptr_t)data) ? -errno : 0;
+}
+
+int
+drmCommandWriteRead(int fd, unsigned long index, void *data, unsigned long size)
+{
+	(void)size;
+	return drmIoctl(fd, DRM_COMMAND_BASE + index, data) ? -errno : 0;
+}
diff --git a/tools/mesa/hakios-panthor/xf86drm.h b/tools/mesa/hakios-panthor/xf86drm.h
new file mode 100644
index 0000000..d2a4da7
--- /dev/null
+++ b/tools/mesa/hakios-panthor/xf86drm.h
@@ -0,0 +1,34 @@
+/*
+ * What Mesa's PanVK (and the Panthor kmod under it) takes from libdrm's xf86drm.h, for a system without Linux's DRM:
+ * hakios-drm's declarations (../hakios-drm/xf86drm.h; the syncobjs are the same, kept in the process over the kernel's
+ * fences) and what Panthor needs besides. The functions are in hakios.panthor.c, which carries Panthor's requests to
+ * the kernel's HakiosGPU (mali=1; drivers/gpu/hakios.gpu.cpp, requests 0x90-0x94) as calls of its user client.
+ * tools/mk-panvk.sh builds PanVK against this directory and links the library in.
+ */
+#ifndef HAKIOS_PANTHOR_XF86DRM_H
+#define HAKIOS_PANTHOR_XF86DRM_H
+
+#include "../hakios-drm/xf86drm.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int drmCloseBufferHandle(int fd, uint32_t handle);
+
+/*
+ * Not libdrm's: mmap() on the device, which Darwin cannot give for a descriptor that means nothing (/dev/null, as in
+ * hakios-drm). An offset from BO_MMAP_OFFSET is a buffer's (its memory, mapped through the user client); Panthor's
+ * LATEST_FLUSH_ID page is a page of zeros (the kernel flushes before every submission anyway). panthor_kmod.c is
+ * patched to call this where it calls os_mmap() on the device (tools/mesa/panvk-darwin.patch).
+ */
+void *hakios_panthor_mmap(void *address, size_t size, int prot, int flags, int fd, off_t offset);
+
+/* Not libdrm's: the one device's render node, for PanVK's enumeration on Darwin (panvk_instance.c, patched) */
+#define HAKIOS_PANTHOR_NODE     "/dev/null"
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
